{
  "manifest_version": 3,
  "name": "Realt.by Currency Converter",
  "version": "1.5",
  "description": "Автоматически конвертирует цены на realt.by в USD/EUR/RUB по актуальному курсу Нацбанка РБ при каждой загрузке страницы",
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.realt.by/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "realt-converter-by@alexis_borovik.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [ "none" ]
      }
    }
  }
}